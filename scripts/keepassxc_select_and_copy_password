#!/usr/bin/env python3
#
# fuzzy-select an entry from a keepassxc database and copy its password.
# the database is unlocked once (the kdf is slow), so copying is instant.

import csv, getpass, os, subprocess, sys

DB = os.environ.get("KEEPASSXC_DB_PATH", os.path.expanduser("~/.secrets/keepassxc/dome.kdbx"))
TIMEOUT = int(os.environ.get("CLIPBOARD_TIMEOUT", 15))
NAME = os.path.basename(DB)
BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"


def die(message):
    sys.exit(f"\033[31m✗ {message}{RESET}")


def run(command, stdin):
    # no start_new_session here: it detaches the controlling tty and fzf needs it
    return subprocess.run(command, input=stdin, text=True, capture_output=True)


if not os.path.isfile(DB):
    die(f"no keepassxc database at {BOLD}{DB}{RESET}")
password = getpass.getpass(f"{BOLD}{NAME}{RESET} master password: ") or die("no password given")

print(f"{DIM}unlocking…{RESET}", end="", flush=True)
export = run(["keepassxc-cli", "export", "-q", "-f", "csv", DB], password)
print("\r\033[K", end="", flush=True)
if export.returncode:
    die(f"could not unlock {NAME} — wrong password?")

entries = [e for e in csv.DictReader(export.stdout.splitlines()) if e["Title"]]
if not entries:
    die(f"{NAME} has no entries")

# the picker shows "title  group"; username and url ride along hidden, for the preview
width = max(len(e["Title"]) for e in entries)
lines = []
for index, e in enumerate(entries):
    group = "/".join(e["Group"].split("/")[1:])
    title = f"{e['Title']:<{width}}  {DIM}{group}{RESET}"
    lines.append(f"{index}\t{title}\t{e['Username'] or '-'}\t{e['URL'] or '-'}")

picked = run(["fzf", "--ansi", "--delimiter=\t", "--with-nth=2", f"--prompt={NAME} > ",
              "--preview", r"printf 'user  %s\nurl   %s\n' {3} {4}"], "\n".join(lines))
if picked.returncode:  # 1 no match, 2 error, 130 esc or ctrl-c
    sys.exit(picked.stderr.strip() or 0)

entry = entries[int(picked.stdout.split("\t")[0])]
if not entry["Password"]:
    die(f"{BOLD}{entry['Title']}{RESET} has no password stored")
# wl-copy forks a child that keeps serving the clipboard, so never pipe its output
subprocess.run(["wl-copy", "--sensitive"], input=entry["Password"], text=True,
               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
subprocess.Popen(["sh", "-c", f"sleep {TIMEOUT}; wl-copy --clear"], start_new_session=True)
print(f"\033[32m✓{RESET} copied {BOLD}{entry['Title']}{RESET} {DIM}· clears in {TIMEOUT}s{RESET}")
